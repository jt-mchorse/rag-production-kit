# Copy to .env (gitignored) and fill in. Nothing loads it automatically:
#   set -a; . ./.env; set +a
# The hermetic test suite needs none of these; `pytest -m pg` needs DATABASE_URL.

# Connection string for the hybrid retriever's Postgres + pgvector backend.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Seconds to wait for a Postgres connection (libpq's own variable). Ships
# blank: rag_kit.db.connect then waits 10 s, where libpq alone would wait
# forever on a host that accepts and never answers (#280).
PGCONNECT_TIMEOUT=

# The Anthropic generator and query rewriter (pip install -e '.[rag-anthropic]').
ANTHROPIC_API_KEY=sk-ant-your-key-here

# The Cohere reranker (pip install -e '.[rerank-cohere]'). The lexical-overlap
# fallback reranker needs no key.
COHERE_API_KEY=your-key-here

# evals/run_eval.py posts the PR comment with this token (e.g. ghp_...);
# `--token-env` names a different variable if you pass it. Ships blank: with no
# token, --post-comment prints the comment as a dry run, and a placeholder here
# defeated that once the file was loaded (#272).
GITHUB_TOKEN=
